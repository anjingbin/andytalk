                    WS_GROUP,48,34,30,14
    CONTROL         "Talk?",IDC_STATIC,"Static",SS_LEFTNOWORDWRAP | 
                    SS_CENTERIMAGE | WS_GROUP,16,34,30,14
    ICON            IDI_ICON3,IDC_STATIC,2,6,20,20
END


