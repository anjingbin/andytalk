END

IDD_CONFIRM DIALOG DISCARDABLE  0, 0, 187, 49
STYLE DS_ABSALIGN | DS_SYSMODAL | DS_MODALFRAME | DS_SETFOREGROUND | 
    DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Talk?"
FONT 9, "宋体"
BEGIN
