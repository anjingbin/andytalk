IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 238, 49
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About talk"
FONT 9, "宋体"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,10,10,20,20
    CTEXT           "AndyTalk  version 3.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    CTEXT           "CopyRight 1999-2000",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "确定",IDOK,176,8,50,14,WS_GROUP
END

IDD_ADDRBOOK DIALOGEX 0, 0, 292, 93
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Address Book"
FONT 9, "宋体", 0, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | 
                    LVS_AUTOARRANGE | WS_BORDER | WS_TABSTOP,2,3,136,87,
                    WS_EX_CLIENTEDGE
    LTEXT           "Name:",IDC_STATIC,146,20,21,8
    EDITTEXT        IDC_NAME,212,18,72,12,ES_AUTOHSCROLL
    LTEXT           "Address:",IDC_STATIC,146,36,34,8
    CONTROL         "IPAddress1",IDC_IP,"SysIPAddress32",WS_TABSTOP,212,34,
                    72,12
    PUSHBUTTON      "&C&lear",IDC_CLEAR,148,52,44,14
    PUSHBUTTON      "&Delete",IDC_DELETE,194,52,44,14
    DEFPUSHBUTTON   "&Save",IDC_SAVE,240,52,44,14
    PUSHBUTTON      "&Connect",IDC_CONNECT,160,76,64,14
    PUSHBUTTON      "Cl&ose",IDOK,226,76,64,14
    GROUPBOX        "User Info",IDC_STATIC,140,3,150,67
END

