IDD_CFG_GENERAL DIALOGEX 0, 0, 300, 181
STYLE WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 9, "宋体", 0, 0, 0x1
BEGIN
    GROUPBOX        "My &name:",IDC_STATIC,4,6,82,34
    EDITTEXT        IDC_MYNAME,10,20,70,12,ES_AUTOHSCROLL
    CONTROL         "&Max connections allowed",IDC_STATIC,"Static",
                    SS_LEFTNOWORDWRAP | SS_CENTERIMAGE | WS_GROUP,7,70,99,12
    EDITTEXT        IDC_MAXCONN,110,70,35,12,ES_AUTOHSCROLL | ES_NUMBER | 
                    WS_GROUP
    CONTROL         "Spin1",IDC_SPIN1,"msctls_updown32",UDS_WRAP | 
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_NOTHOUSANDS | UDS_HOTTRACK,130,70,11,
                    12
    LTEXT           "&Disconnect when idle for ",IDC_STATIC,7,86,101,10,
                    SS_CENTERIMAGE
    EDITTEXT        IDC_TIME1,110,84,35,12,ES_AUTOHSCROLL | ES_NUMBER | 
                    WS_GROUP
    CONTROL         "Spin1",IDC_SPIN2,"msctls_updown32",UDS_WRAP | 
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_HOTTRACK,130,84,11,12
    LTEXT           "seconds",IDC_STATIC,147,84,40,12,SS_CENTERIMAGE
    LTEXT           "&Send absent message after ",IDC_STATIC,6,100,100,10,
                    SS_CENTERIMAGE
    EDITTEXT        IDC_TIME2,110,98,35,12,ES_AUTOHSCROLL | ES_NUMBER | 
                    WS_GROUP
    CONTROL         "Spin1",IDC_SPIN3,"msctls_updown32",UDS_WRAP | 
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_NOTHOUSANDS | UDS_HOTTRACK,130,98,11,
                    12
    LTEXT           "seconds",IDC_STATIC,147,98,40,12,SS_CENTERIMAGE
    CONTROL         "&Beep when new message received",IDC_BEEP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,8,116,194,12,0,HIDC_BEEP
    CONTROL         "&Need my confirmation to impending request",IDC_NEED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,130,194,12,0,
                    HIDC_NEED
    CONTROL         "&Only accept access from IP in AddressBook ",IDC_ONLY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,144,210,12
    GROUPBOX        "Miscellaneous:",IDC_STATIC,2,52,296,128
    CONTROL         "&Auto load at Windows startup",IDC_STARTUP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,8,158,210,12
END

IDD_PERSONAL DIALOGEX 0, 0, 300, 181
