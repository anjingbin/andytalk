/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Connect...",                 ID_CONNECT
        MENUITEM "&Disconnect",                 ID_DISC, GRAYED
        MENUITEM "&Beep",                       ID_BEEP, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t",                        ID_EDIT_CUT
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "&Paste",                      ID_EDIT_PASTE
        MENUITEM SEPARATOR
        POPUP "&Scrollbar"
        BEGIN
            MENUITEM "&Horizontal",                 ID_HSCROLL, CHECKED
            MENUITEM "&Vertical",                   ID_VSCROLL, CHECKED
        END
    END
    POPUP "&Option"
    BEGIN
        MENUITEM "&Want to talk",               ID_WANTTALK
        MENUITEM SEPARATOR
        MENUITEM "&Setting...",                 ID_SETTING
        MENUITEM "&Font...",                    ID_FONT
        MENUITEM "&Background...",              ID_BACKCOLOR
        MENUITEM SEPARATOR
        MENUITEM "&Address Book..",             ID_ADDRBOOK
        MENUITEM "&Log list..",                 ID_LOG
        MENUITEM SEPARATOR
        MENUITEM "Sa&ve ",                      ID_SAVE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   ID_APP_ABOUT
    END
END

IDR_TRAYMENU MENU DISCARDABLE 
BEGIN
    POPUP "popup"
    BEGIN
        MENUITEM "&Want to talk",               ID_WANTTALK
        MENUITEM "&Setting...",                 ID_SETTING
        MENUITEM "E&xit",                       ID_APP_EXIT
        MENUITEM SEPARATOR
        MENUITEM "&About",                      ID_APP_ABOUT
    END
END


