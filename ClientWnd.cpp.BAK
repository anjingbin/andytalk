#define ABFILE "AddressBook.dat"
#define LOGFILE "Log.dat"
#define CFGFILE "Config.dat"

CClientWnd::CClientWnd()
{
	m_psockListen=NULL;
	m_bWantTalk=true;
}

CClientWnd::~CClientWnd()
{
	if(m_psockListen)
		delete m_psockListen;
}



